---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	date: Date;
	category: string;
	excerpt: string;
}

const { title, date, category, excerpt } = Astro.props;

const formattedDate = date.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={excerpt} currentPath={`/posts/${Astro.params.slug}`}>
	<article class="post narrow container">
		<header class="post-header">
			<a href="/archive" class="back-link">&larr; archive</a>
			<div class="post-meta">
				<span class="post-date">{formattedDate}</span>
				<span class="post-category">{category}</span>
			</div>
			<h1>{title}</h1>
		</header>
		<div class="post-content">
			<slot />
		</div>
	</article>
</BaseLayout>

<style>
	.post {
		padding-top: 3rem;
		padding-bottom: 3rem;
	}

	.back-link {
		font-size: 0.85rem;
		color: var(--text-muted);
		display: inline-block;
		margin-bottom: 1.25rem;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.post-header {
		margin-bottom: 2.5rem;
	}

	.post-meta {
		display: flex;
		gap: 1rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
	}

	.post-category {
		color: var(--accent);
	}

	.post-header h1 {
		font-size: 2.25rem;
		line-height: 1.25;
	}

	.post-content {
		line-height: 1.75;
	}

	.post-content :global(p) {
		margin-bottom: 1.25rem;
	}

	.post-content :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
	}

	.post-content :global(h3) {
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
	}

	.post-content :global(li) {
		margin-bottom: 0.35rem;
	}

	.post-content :global(blockquote) {
		border-left: 3px solid var(--accent);
		padding-left: 1rem;
		margin: 1.5rem 0;
		color: var(--text-secondary);
	}

	.post-content :global(img) {
		max-width: 100%;
		border-radius: 6px;
		margin: 1.5rem 0;
	}

	.post-content :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.post-content :global(a:hover) {
		color: var(--text-primary);
	}

	@media (max-width: 640px) {
		.post-header h1 {
			font-size: 1.75rem;
		}
	}
</style>
