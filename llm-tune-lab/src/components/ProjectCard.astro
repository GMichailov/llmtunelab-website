---
interface Props {
	title: string;
	description: string;
	status: string;
	tags: string[];
	links?: {
		github?: string;
		paper?: string;
		demo?: string;
	};
	date: Date;
	updated?: Date;
	slug: string;
}

const { title, description, status, tags, links, date, updated, slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const formattedDate = date.toISOString().slice(0, 10);
const formattedUpdated = updated ? updated.toISOString().slice(0, 10) : null;

const statusLabel: Record<string, string> = {
	'active': 'active',
	'in-progress': 'in progress',
	'completed': 'completed',
	'on-hold': 'on hold',
};
---

<article class="project-card" data-status={status}>
	<div class="card-top">
		<span class={`status-badge status-${status}`}>{statusLabel[status] ?? status}</span>
		<span class="card-date">{formattedDate}</span>
	</div>

	<h3 class="card-title">
		<a href={base + 'projects/' + slug}>{title}</a>
	</h3>

	<p class="card-desc">{description}</p>

	<div class="card-tags">
		{tags.map(tag => (
			<span class="tag">{tag}</span>
		))}
	</div>

	{links && Object.values(links).some(Boolean) && (
		<div class="card-links">
			{links.github && <a href={links.github} class="link-btn" target="_blank" rel="noopener">github &rarr;</a>}
			{links.paper && <a href={links.paper} class="link-btn" target="_blank" rel="noopener">paper &rarr;</a>}
			{links.demo && <a href={links.demo} class="link-btn" target="_blank" rel="noopener">demo &rarr;</a>}
		</div>
	)}

	{formattedUpdated && (
		<span class="card-updated">updated {formattedUpdated}</span>
	)}
</article>

<style>
	.project-card {
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transition: border-color 0.15s ease;
		background: transparent;
	}

	.project-card:hover {
		border-color: var(--accent);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.status-badge {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.2rem 0.6rem;
		border-radius: 3px;
	}

	.status-active {
		color: var(--status-active);
		background: rgba(34, 197, 94, 0.12);
	}

	.status-in-progress {
		color: var(--status-progress);
		background: rgba(245, 158, 11, 0.12);
	}

	.status-completed,
	.status-on-hold {
		color: var(--text-muted);
		background: rgba(107, 114, 128, 0.12);
	}

	.card-date {
		font-size: 0.8rem;
		color: var(--text-muted);
	}

	.card-title {
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.card-title a {
		color: var(--text-primary);
	}

	.card-title a:hover {
		color: var(--accent);
	}

	.card-desc {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tag {
		font-size: 0.75rem;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 3px;
		padding: 0.15rem 0.5rem;
	}

	.card-links {
		display: flex;
		gap: 0.75rem;
		margin-top: auto;
	}

	.link-btn {
		font-size: 0.8rem;
		color: var(--accent);
		font-weight: 500;
	}

	.link-btn:hover {
		color: var(--text-primary);
	}

	.card-updated {
		font-size: 0.7rem;
		color: var(--text-muted);
	}
</style>
